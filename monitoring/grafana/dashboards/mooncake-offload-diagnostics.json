          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "clamp_min(sum(deriv(master_allocated_bytes{job=~\"$master_job\",instance=~\"$master_instance\"}[$__rate_interval])) + sum(rate(master_evicted_size_bytes_mem{job=~\"$master_job\",instance=~\"$master_instance\"}[$__rate_interval])), 0)",
          "legendFormat": "Estimated memory ingress",
          "refId": "A"
        },
        {
          "expr": "sum(rate(master_evicted_size_bytes_mem{job=~\"$master_job\",instance=~\"$master_instance\"}[$__rate_interval]))",
          "legendFormat": "Memory reclaimed after eviction/offload",
          "refId": "B"
        },
        {
          "expr": "sum(deriv(master_allocated_bytes{job=~\"$master_job\",instance=~\"$master_instance\"}[$__rate_interval]))",
          "legendFormat": "Memory allocated net growth",
          "refId": "C"
        },
        {
          "expr": "sum(deriv(master_allocated_file_size_bytes{job=~\"$master_job\",instance=~\"$master_instance\"}[$__rate_interval]))",
          "legendFormat": "File storage logical net growth",
          "refId": "D"
        },
        {
          "expr": "sum(rate(mooncake_ssd_write_bytes_total{job=~\"$client_job\",instance=~\"$client_instance\"}[$__rate_interval]))",
          "legendFormat": "Client SSD physical writes (optional)",
          "refId": "E"
        }
      ],
